{
  "manifest_version": 2,
  "id": "alan.expression-rag",
  "version": "1.0.3",
  "name": "精选表达检索",
  "description": "按当前聊天语义检索精选表达示例并注入回复参考；随包附带68条脱敏示例语料；自选 embedding 模型、增量索引、WebUI 预览与追加导入、QQ 表情转换；不读取封存记忆库。",
  "author": {"name": "Alan", "url": "https://github.com/touching-fishfish"},
  "license": "MIT",
  "urls": {"repository": "https://github.com/touching-fishfish/maibot-expression-rag"},
  "host_application": {"min_version": "1.3.12", "max_version": "1.99.99"},
  "sdk": {"min_version": "2.12.0", "max_version": "2.99.99"},
  "dependencies": [],
  "capabilities": [
    "hook.maisaka.replyer.before_request",
    "hook.send_service.before_send",
    "message.get_by_id",
    "message.get_recent",
    "llm.embed",
    "llm.get_available_models"
  ],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]},
  "plugin_type": "extension",
  "display": {"icon": {"type": "emoji", "value": "🔎"}},
  "changelog": "CHANGELOG.md"
}
